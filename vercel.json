{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "outputDirectory": "."
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/research/federal-awards",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/research/sam-opportunities",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/ai/research-enrichment",
      "schedule": "30 */12 * * *"
    }
  ]
}
