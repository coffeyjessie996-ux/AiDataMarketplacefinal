# Local development environment (example)
# Copy this to .env.local (do NOT commit .env.local) and edit secrets as needed.

# Postgres running via docker-compose (username/password and DB match docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_marketplace?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_marketplace?schema=public"

# API and frontend
API_ORIGIN="http://localhost:4000"
NEXT_PUBLIC_API_URL="/api"
FRONTEND_URL="http://localhost:3000"
PORT=4000

# Auth
JWT_SECRET="dev-local-change-me"

# Vercel/Sentry placeholders (optional)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_DSN=""

# Supabase example placeholders (if using Supabase instead of local Postgres)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

