# Production/runtime environment
# For Vercel serverless runtime, copy the exact Transaction Pooler URI from
# Supabase Dashboard > Connect > Transaction pooler. Do not guess the pooler host.
# Replace the placeholders locally; never commit real credentials.
SUPABASE_POOLER_URL="postgresql://postgres.<PROJECT_REF>:<SUPABASE_DATABASE_PASSWORD>@<SHARED_POOLER_HOST>:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=10&sslmode=require"

# Direct connection is retained for local tools/migrations that support IPv6.
DATABASE_URL="postgresql://postgres:<SUPABASE_DATABASE_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"
PORT=4000
FRONTEND_URL=https://<YOUR-WEB-DOMAIN>
NODE_ENV=production
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
STRIPE_SECRET_KEY=<OPTIONAL_STRIPE_SECRET_KEY>
